# Optional: Custom Canva MCP OAuth Client Credentials.
# Leave blank to auto-register dynamically via https://mcp.canva.com/register (RFC 7591).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Optional: Directory where Canva OAuth tokens and account registry are stored.
# Defaults to ~/.canva-skills-mcp
CANVA_STATE_DIR=

# Optional: OAuth local callback port (default: 8080)
CANVA_OAUTH_PORT=8080

# Optional: Set to 1 to also mirror remote Canva MCP tools directly in tools/list when authenticated
CANVA_PROXY_REMOTE_TOOLS=0
